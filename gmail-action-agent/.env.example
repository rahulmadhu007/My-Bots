# Server
HOST=0.0.0.0
PORT=8000

# Gmail OAuth2 (optional — without these the app runs in demo mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Or path to a downloaded OAuth client secrets JSON from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=credentials.json

# Public URL used when building the OAuth redirect (must match Google Cloud Console)
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Optional LLM enhancement for classification (heuristics always work without these)
GROQ_API_KEY=
OPENAI_API_KEY=
# openai | groq  (auto-detects from which key is set if left blank)
LLM_PROVIDER=
